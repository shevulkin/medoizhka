Options -Indexes

# ─────────────────────────────────────────────────────────── швидкість ───
# Обидва блоки під IfModule: на хостингу без цих модулів файл має лишатись
# робочим, а не валити сайт п'ятисоткою.

# Стиснення тексту. Без нього CSS їде як 97 КБ замість ~18, а HTML — як 30
# замість ~6. Це найдешевше, що можна зробити для першого відкриття з
# телефона: саме стилі блокують перший показ сторінки.
# Зображення, шрифти й woff2 тут не згадані навмисно — вони вже стиснуті,
# і повторне стиснення лише витрачає процесор.
# Через SetOutputFilter, а не звичніший AddOutputFilterByType: той належить
# mod_filter, а не mod_deflate, і на сервері, де є один без іншого, обгортка
# <IfModule mod_deflate.c> його пропускає — а сайт після цього віддає 500 на
# кожен запит. SetOutputFilter — директива ядра, тож достатньо самого deflate.
<IfModule mod_deflate.c>
  <FilesMatch "\.(php|css|js|json|xml|svg|webmanifest|txt)$">
    SetOutputFilter DEFLATE
  </FilesMatch>
</IfModule>

# Кеш статики. Адреси css і js містять час зміни файлу (asset_v), тож рік
# тут безпечний: змінили файл — змінилась адреса, браузер піде по нову.
# Шрифти не змінюються ніколи. А от зображення підмінюють тим самим імʼям
# (перезалили фото товару), тому їм тиждень: інакше стару картинку довелося б
# чекати рік.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

# Те саме через mod_headers — на випадок, коли mod_expires вимкнений, а він
# буває вимкнений частіше. Обидва блоки разом не конфліктують: браузер бере
# Cache-Control, а Expires лишається для зовсім старих проксі.
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.woff2?$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpe?g|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# Кеш LiteSpeed для цього сайту вимкнено. Він лишився від WordPress (LiteSpeed Cache)
# і віддавав старі сторінки замість нових. Сторінки тут персональні: кошик, ім'я,
# CSRF-токен у формах, тож спільна кешована копія показала б одній людині дані іншої.
<IfModule LiteSpeed>
  CacheLookup off
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Поки сайт закритий від пошуковиків (налаштування seo_noindex), PHP тримає в корені
  # сайту файл .noindex. Тоді заборону індексації отримують і статичні файли (фото, стилі),
  # які Apache віддає сам, — інакше картинки могли б потрапити в Google Картинки.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteCond %{REQUEST_FILENAME} ^(.*/)assets/
  RewriteCond %1.noindex -f
  RewriteRule ^ - [E=SITE_NOINDEX:1]
  # Один домен для пошуковиків: www.medoizhka.com → medoizhka.com (так було проіндексовано)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
  # Примусовий HTTPS на хостингу. Локально (localhost) сертифіката немає, тож там не чіпаємо
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
  # Захист фото від прямих посилань з чужих сайтів. Пропускаємо: порожній Referer (прямий перехід,
  # месенджери, більшість краулерів), наш домен, пошукові системи й соцмережі (Google Картинки,
  # прев'ю посилань), а також їхніх ботів за User-Agent (Googlebot, Storebot-Google для Merchant Center,
  # bingbot, превʼю Facebook/Telegram/WhatsApp). Усім іншим — 403. Індексація фото не страждає.
  RewriteCond %{REQUEST_URI} /assets/uploads/.+\.(webp|jpe?g|png|gif)$ [NC]
  RewriteCond %{HTTP_REFERER} !^$
  RewriteCond %{HTTP_REFERER} !^https?://([^/]+\.)?(medoizhka\.com|localhost|127\.0\.0\.1)(:[0-9]+)?(/|$) [NC]
  RewriteCond %{HTTP_REFERER} !^https?://([^/]+\.)?(google\.(com\.[a-z]{2}|co\.[a-z]{2}|[a-z]{2,3})|bing\.com|yahoo\.com|duckduckgo\.com|yandex\.[a-z]+|ecosia\.org|baidu\.com|facebook\.com|instagram\.com|t\.me|telegram\.org|whatsapp\.com|pinterest\.(com\.[a-z]{2}|co\.[a-z]{2}|[a-z]{2,3}))(/|$) [NC]
  RewriteCond %{HTTP_USER_AGENT} !(Googlebot|Google-InspectionTool|GoogleOther|Storebot-Google|AdsBot-Google|APIs-Google|bingbot|BingPreview|Applebot|DuckDuckBot|YandexBot|YandexImages|facebookexternalhit|Twitterbot|TelegramBot|WhatsApp|Slackbot|LinkedInBot|PinterestBot) [NC]
  RewriteRule ^ - [F]
  # /\.git — на випадок, якщо клон опиниться всередині public_html: там лежить
  # уся історія проєкту, включно з тим, що колись видалили з файлів
  RewriteCond %{REQUEST_URI} /app/|/storage/|/bin/|/migrations?/|config|/\.git
  RewriteRule ^ - [F]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [QSA,L]
</IfModule>

# Заборони нижче навмисно дублюють RewriteRule вище: якщо mod_rewrite вимкнений
# або AllowOverride обмежений, конфіг із паролями БД не має віддаватися жодним шляхом.
# pem/crt/key — ключі платіжного шлюзу (storage/keys). Приватним ключем
# підписуються запити на списання коштів: той, хто його забере, зможе
# створювати платежі від імені магазину. Тека вже закрита правилом вище, але
# саме тут ціна вимкненого mod_rewrite найвища, тож розширення названі окремо.
<FilesMatch "\.(sqlite|log|md|lock|yml|yaml|ini|sh|pem|crt|cer|key|p12|pfx)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Службові файли git: .gitignore розповідає, що саме ховають, а .gitattributes
# і подібні нічого не дають відвідувачу
<FilesMatch "^\.git">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# config.php / config.local.php — секрети; фронт-контролер підключає їх сам
<FilesMatch "^config.*\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Заборона індексації статичних файлів, поки сайт закритий (див. SITE_NOINDEX вище)
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow" env=SITE_NOINDEX
</IfModule>
